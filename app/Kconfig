menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM
    choice 
        prompt "LED blink sleep time"
        default LED_BLINK_SLEEP_TIME_1000MS

        config LED_BLINK_SLEEP_TIME_250MS
            bool "250ms (ultra fast)"

        config LED_BLINK_SLEEP_TIME_500MS
            bool "500ms (fast)"

        config LED_BLINK_SLEEP_TIME_1000MS
            bool "1s (medium)"

        config LED_BLINK_SLEEP_TIME_2000MS
            bool "2s (slow)"
    endchoice

    config BLINK_SLEEP_TIME_MS
        int
        default 250 if LED_BLINK_SLEEP_TIME_250MS
        default 500 if LED_BLINK_SLEEP_TIME_500MS
        default 1000 if LED_BLINK_SLEEP_TIME_1000MS
        default 2000 if LED_BLINK_SLEEP_TIME_2000MS 
        default 1000

    menuconfig ADVANCED_LED_SETTINGS
        bool "Advanced LED Settings"
        default n

    if ADVANCED_LED_SETTINGS
        config LED_BRIGHTNESS
            int "(100) LED brightness (0-100)"
            default 100
            range 0 100

        config LED_FADE_DURATION
            int "(500) LED fade duration (ms)"
            default 500
            range 0 5000

        menu "Expert Settings"
            config ENABLE_LED_DEBUGGING
                bool "Enable LED debugging"
                default n
            
            config CUSTOM_BLINK_PATTERN
                bool "Custom blink pattern"
                default n
        endmenu
    endif

endif

source "Kconfig.zephyr"